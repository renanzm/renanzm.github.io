---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  titulo?: string;
  descricao?: string;
  /** URL de imagem para redes sociais (absoluta ou relativa ao site) */
  imagem?: string;
}

const { titulo, descricao = site.descricao, imagem } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · ${site.cargo}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemAbs = imagem ? new URL(imagem, Astro.site).href : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {imagemAbs && <meta property="og:image" content={imagemAbs} />}
    <meta name="twitter:card" content={imagemAbs ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#09090b" />
  </head>
  <body>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>
    <header class="topo">
      <nav class="container nav" aria-label="Principal">
        <a href="/" class="marca mono" aria-label={`${site.nome}, início`}>{site.apelido}<span>.</span></a>
        <ul>
          <li><a href="/#projetos">Projetos</a></li>
          <li><a href="/#sobre">Sobre</a></li>
          <li>
            <a href={site.redes[0].url} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true"> ↗</span></a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="container rodape-inner">
        <span class="muted">© {new Date().getFullYear()} {site.nome}</span>
        <ul>
          <li><a href="/projetos">Índice de projetos</a></li>
          {
            site.redes.map((r) => (
              <li>
                <a href={r.url} target="_blank" rel="noopener noreferrer">
                  {r.nome}
                </a>
              </li>
            ))
          }
          {site.email && (
            <li>
              <a href={`mailto:${site.email}`}>E-mail</a>
            </li>
          )}
        </ul>
      </div>
    </footer>
    <script>
      import { iniciarLuzDoSite } from '../scripts/luz-site';
      iniciarLuzDoSite();
    </script>
  </body>
</html>

<style>
  .pular {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
  }
  .pular:focus {
    top: 12px;
  }
  .topo {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header);
    background: rgb(9 9 11 / 0.72);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .marca {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .marca span {
    color: var(--accent);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .nav ul a:hover {
    color: #fff;
  }
  @media (max-width: 420px) {
    .nav ul {
      gap: 16px;
    }
  }
  main {
    min-height: 100svh;
  }
  .rodape {
    border-top: 1px solid var(--line);
    padding: 32px 0 40px;
    font-size: 0.9rem;
  }
  .rodape-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
  }
  .rodape a {
    color: var(--muted);
    text-decoration: none;
  }
  .rodape a:hover {
    color: var(--text);
  }
</style>
