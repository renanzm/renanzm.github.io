---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada">
  <section>
    <div class="container">
      <p class="rotulo">404</p>
      <h1>Essa página não existe.</h1>
      <p class="muted">O endereço pode ter mudado ou o projeto saiu do ar.</p>
      <a href="/" class="btn btn-solido"><span aria-hidden="true">←</span> Voltar ao início</a>
    </div>
  </section>
</Base>

<style>
  section {
    padding: calc(var(--header) + 120px) 0 120px;
  }
  h1 {
    margin: 14px 0 16px;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
  }
  p.muted {
    margin: 0 0 32px;
    font-size: 1.1rem;
  }
</style>
