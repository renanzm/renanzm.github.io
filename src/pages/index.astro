---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Landing from '../landing/Landing';
import type { DadosLanding, MidiaCartao, ProjetoCartao } from '../landing/tipos';
import { site } from '../data/site';
import { acaoPrincipal, projetosPublicados, rotuloStatus } from '../data/projetos';
import retrato from '../assets/hero/retrato.webp';

const projetos = await projetosPublicados();
const vitrine = projetos.filter((p) => p.data.status !== 'arquivado');
const arquivados = projetos.filter((p) => p.data.status === 'arquivado');
const [github, linkedin] = site.redes;

// Retrato da abertura em AVIF e WebP, em várias larguras (a maior é a do arquivo original).
// Qualidade um pouco mais alta para não perder o detalhe do upscale.
const larguras = [640, 960, 1280, 1600, retrato.width];
const [fotoAvif, fotoWebp] = await Promise.all([
  getImage({ src: retrato, widths: larguras, format: 'avif', quality: 70 }),
  getImage({ src: retrato, widths: larguras, format: 'webp', quality: 82 }),
]);

const cartoes: ProjetoCartao[] = await Promise.all(
  vitrine.map(async (p) => {
    const d = p.data;
    let midia: MidiaCartao | null = null;
    if (d.video) {
      midia = { tipo: 'video', src: d.video.src, poster: d.video.poster, largura: d.video.largura, altura: d.video.altura };
    } else if (d.capa) {
      const img = await getImage({ src: d.capa, widths: [480, 800, 1200, 1600], format: 'webp' });
      midia = {
        tipo: 'imagem',
        src: img.src,
        srcset: img.srcSet.attribute,
        largura: d.capa.width,
        altura: d.capa.height,
        encaixe: d.capa.width / d.capa.height >= 1.4 ? 'cobrir' : 'conter',
      };
    }
    return {
      id: p.id,
      titulo: d.titulo,
      resumo: d.resumo,
      descricao: d.descricao,
      destaques: d.destaques,
      chips: [d.plataforma, ...d.stack].filter((c): c is string => Boolean(c)),
      cor: d.cor,
      status: d.teaser ? `Sneak peek · ${rotuloStatus[d.status]}` : rotuloStatus[d.status],
      teaser: d.teaser,
      acao: acaoPrincipal(p),
      pagina: `/projetos/${p.id}`,
      midia,
    };
  }),
);

const dados: DadosLanding = {
  nome: site.nome,
  cargo: site.cargo,
  empresa: site.empresa,
  cidade: site.cidade,
  chamada: site.chamada,
  declaracao: site.declaracao,
  bio: site.bio,
  fatos: site.fatos,
  stack: site.stack,
  extras: site.extras,
  github: github.url,
  linkedin: linkedin.url,
  foto: {
    src: fotoWebp.src,
    srcsetAvif: fotoAvif.srcSet.attribute,
    srcsetWebp: fotoWebp.srcSet.attribute,
    largura: retrato.width,
    altura: retrato.height,
    alt: `Retrato em preto e branco de ${site.nome}`,
  },
  projetos: cartoes,
  arquivados: arquivados.map((p) => ({ id: p.id, titulo: p.data.titulo, resumo: p.data.resumo })),
};
---

<Base sobreFoto>
  <script is:inline>
    // Esconde a abertura até a animação assumir (o CSS mostra tudo sozinho se o script falhar)
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('vai-animar');
  </script>
  <Landing client:load {...dados} />
</Base>
