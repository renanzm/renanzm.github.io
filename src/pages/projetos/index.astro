---
import Base from '../../layouts/Base.astro';
import { projetosPublicados, rotuloStatus } from '../../data/projetos';

const projetos = await projetosPublicados();
const dois = (n: number) => String(n).padStart(2, '0');
---

<Base titulo="Projetos" descricao="Índice de todos os meus apps, ferramentas e jogos, com links e downloads.">
  <section class="indice">
    <div class="container">
      <p class="rotulo">Índice</p>
      <h1>Projetos</h1>
      <ol class="lista">
        {
          projetos.map((p, i) => (
            <li style={`--c: ${p.data.cor}`}>
              <a href={`/projetos/${p.id}`}>
                <span class="num mono">{dois(i + 1)}</span>
                <span class="titulo">{p.data.titulo}</span>
                <span class="resumo">{p.data.resumo}</span>
                <span class="status">{p.data.teaser ? 'Sneak peek' : rotuloStatus[p.data.status]}</span>
                <span class="seta" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .indice {
    padding: calc(var(--header) + 72px) 0 96px;
  }
  h1 {
    margin: 14px 0 48px;
    font-size: clamp(2.8rem, 8vw, 5.5rem);
  }
  .lista {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .lista a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    grid-template-areas:
      'num titulo seta'
      'num resumo seta'
      'num status seta';
    gap: 4px 16px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.2s;
  }
  .lista a:hover {
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 7%, transparent), transparent 60%);
  }
  .num {
    grid-area: num;
    padding-top: 0.35em;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .titulo {
    grid-area: titulo;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .resumo {
    grid-area: resumo;
    color: var(--text-2);
  }
  .status {
    grid-area: status;
    margin-top: 6px;
  }
  .seta {
    grid-area: seta;
    align-self: center;
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }
  .lista a:hover .seta {
    color: var(--text);
    transform: translateX(4px);
  }
  @media (min-width: 900px) {
    .lista a {
      grid-template-columns: 2.5rem 14rem 1fr 11rem auto;
      grid-template-areas: 'num titulo resumo status seta';
      align-items: baseline;
      gap: 24px;
    }
    .status {
      margin-top: 0;
    }
  }
</style>
