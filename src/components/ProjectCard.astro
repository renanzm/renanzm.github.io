---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const { titulo, resumo, tags, status, capa, links, downloads } = projeto.data;
---

<article class="card" data-tags={tags.join(',')}>
  <a href={`/projetos/${projeto.id}`} class="capa" tabindex="-1" aria-hidden="true">
    {
      capa ? (
        <img src={capa} alt="" loading="lazy" />
      ) : (
        <span class="capa-vazia mono">{titulo.slice(0, 2).toLowerCase()}</span>
      )
    }
  </a>
  <div class="corpo">
    <h3><a href={`/projetos/${projeto.id}`}>{titulo}</a></h3>
    <p class="muted">{resumo}</p>
    <div class="meta">
      {status !== 'ativo' && <span class={`tag status-${status}`}>{status}</span>}
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="acoes muted mono">
      {links.length > 0 && <span>↗ {links.length} link{links.length > 1 ? 's' : ''}</span>}
      {downloads.length > 0 && <span>↓ {downloads.length} download{downloads.length > 1 ? 's' : ''}</span>}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    border-color: #3a404c;
    transform: translateY(-2px);
  }
  .capa {
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .capa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .capa-vazia {
    font-size: 2rem;
    color: var(--border);
    font-weight: 700;
  }
  .corpo {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  h3 {
    font-size: 1.1rem;
    margin: 0;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card {
    position: relative;
  }
  p {
    margin: 0;
    font-size: 0.95rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .status-beta {
    color: #f5c66b;
    border-color: #5a4a26;
  }
  .status-arquivado {
    color: var(--muted);
    border-style: dashed;
  }
  .acoes {
    margin-top: auto;
    display: flex;
    gap: 14px;
    font-size: 0.8rem;
  }
</style>
