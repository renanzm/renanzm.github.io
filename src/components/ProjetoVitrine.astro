---
import { Image } from 'astro:assets';
import MostradorFocus from './MostradorFocus.astro';
import { acaoPrincipal, rotuloStatus, type Projeto } from '../data/projetos';

interface Props {
  projeto: Projeto;
  indice: number;
  total: number;
}

const { projeto, indice, total } = Astro.props;
const d = projeto.data;
const acao = acaoPrincipal(projeto);
const pagina = `/projetos/${projeto.id}`;
const dois = (n: number) => String(n).padStart(2, '0');
// Imagens largas preenchem a moldura; altas ou quadradas ficam inteiras
const larga = d.capa ? d.capa.width / d.capa.height >= 1.4 : false;
// Com vídeo, a moldura segue a proporção dele
const proporcao = d.video
  ? `${d.video.largura} / ${d.video.altura}`
  : larga && d.capa
    ? `${d.capa.width} / ${d.capa.height}`
    : undefined;
const encaixe = d.video ? 'com-video' : larga ? 'cobrir' : 'conter';
---

<section
  class:list={['vitrine', { invertida: indice % 2 === 1 }]}
  id={projeto.id}
  style={`--c: ${d.cor}`}
  aria-labelledby={`titulo-${projeto.id}`}
  data-vitrine
>
  <div class="container grade">
    <div class="info">
      <div class="linha-topo">
        <span class="rotulo">{dois(indice + 1)} / {dois(total)}</span>
        <span class="status">{d.teaser ? `Sneak peek · ${rotuloStatus[d.status]}` : rotuloStatus[d.status]}</span>
      </div>
      <h2 id={`titulo-${projeto.id}`}>{d.titulo}</h2>
      <p class="resumo">{d.resumo}</p>
      {d.descricao && <p class="descricao">{d.descricao}</p>}
      {
        d.destaques.length > 0 && (
          <ul class="destaques">
            {d.destaques.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      <div class="chips">
        {d.plataforma && <span class="chip">{d.plataforma}</span>}
        {d.stack.map((s) => <span class="chip">{s}</span>)}
      </div>
      <div class="acoes">
        <a
          class="btn btn-solido"
          href={acao.url}
          {...(acao.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {acao.rotulo}
        </a>
        {
          acao.url !== pagina && (
            <a class="btn" href={pagina}>
              Detalhes <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </div>

    <a
      class:list={['midia', 'moldura', encaixe]}
      style={proporcao ? `aspect-ratio: ${proporcao}` : undefined}
      href={pagina}
      tabindex="-1"
      aria-hidden="true"
    >
      {
        d.video ? (
          <>
            <video
              class="video"
              src={d.video.src}
              poster={d.video.poster}
              width={d.video.largura}
              height={d.video.altura}
              muted
              loop
              playsinline
              preload="metadata"
              data-video
            />
            {projeto.id === 'focus-temp-tool' && (
              <div class="mostrador-mini">
                <MostradorFocus />
              </div>
            )}
          </>
        ) : projeto.id === 'focus-temp-tool' ? (
          <MostradorFocus />
        ) : d.capa ? (
          <Image
            src={d.capa}
            alt=""
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 960px) 660px, 100vw"
            loading={indice === 0 ? 'eager' : 'lazy'}
          />
        ) : (
          <span class="sem-capa">{d.titulo}</span>
        )
      }
      {d.teaser && <span class="selo mono">em breve</span>}
    </a>
  </div>
</section>

<style>
  .vitrine {
    position: relative;
    min-height: calc(100svh - var(--header));
    display: flex;
    align-items: center;
    padding: 72px 0;
    border-top: 1px solid var(--line);
    background: var(--bg);
    overflow: clip;
  }
  /* Desktop com animações: cada projeto sobe como um cartão por cima do anterior */
  :global(.pilha) .vitrine {
    border-radius: 32px 32px 0 0;
    border-top-color: var(--line-2);
    box-shadow: 0 -28px 80px rgb(0 0 0 / 0.6);
  }
  :global(.pilha) .grade {
    transform-origin: 50% 0%;
  }
  .vitrine::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -30%;
    width: 120%;
    height: 90%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 11%, transparent), transparent);
    pointer-events: none;
  }
  .grade {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 72px;
    }
    .invertida .grade {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .invertida .info {
      order: 2;
    }
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 36rem;
  }
  .linha-topo {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  h2 {
    font-size: clamp(2.6rem, 6.2vw, 4.75rem);
  }
  .resumo {
    margin: 0;
    font-size: clamp(1.12rem, 1.7vw, 1.32rem);
    line-height: 1.45;
    color: var(--text);
  }
  .descricao {
    margin: 0;
    color: var(--text-2);
  }
  .destaques {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .destaques li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .destaques li::before {
    content: '';
    width: 6px;
    height: 6px;
    margin-top: 0.62em;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 8px var(--c);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  .midia {
    display: block;
    aspect-ratio: 16 / 10;
    transition: border-color 0.2s;
  }
  .midia :global(svg) {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .video {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--surface);
  }
  /* Focus: o ponteiro (animado pela rolagem) num cartão menor sobre o vídeo do terminal */
  .mostrador-mini {
    position: absolute;
    right: 3%;
    bottom: 5%;
    width: 46%;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    overflow: hidden;
    box-shadow: 0 18px 50px rgb(0 0 0 / 0.55);
  }
  .mostrador-mini :global(svg) {
    display: block;
    height: auto;
  }
  /* No celular a imagem vem antes do texto */
  @media (max-width: 959px) {
    .midia {
      order: -1;
    }
  }
  .midia:hover {
    border-color: var(--line-2);
  }
  .midia :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .cobrir :global(img) {
    object-fit: cover;
  }
  .conter :global(img) {
    object-fit: contain;
    padding: clamp(18px, 5%, 44px);
    filter: drop-shadow(0 24px 48px rgb(0 0 0 / 0.45));
  }
  .sem-capa {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 2rem;
    color: var(--muted);
  }
  .selo {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
    background: rgb(9 9 11 / 0.7);
    backdrop-filter: blur(8px);
    color: var(--c);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Notebooks com tela baixa: tudo cabe sem rolar dentro da seção */
  @media (min-width: 960px) and (max-height: 860px) {
    .vitrine {
      padding: 40px 0;
    }
    .info {
      gap: 14px;
    }
    h2 {
      font-size: clamp(2.4rem, 5vw, 3.6rem);
    }
    .resumo {
      font-size: 1.08rem;
    }
    .descricao,
    .destaques li {
      font-size: 0.9rem;
    }
    .destaques {
      gap: 6px;
    }
  }

</style>
